# Copy to frontend/.env.local (git-ignored) and fill in.

# API Gateway URL (terraform output api_url). Leave empty to use mock data.
VITE_API_BASE_URL=https://xxxxxxxxxx.execute-api.ap-south-1.amazonaws.com

# "live" (default when VITE_API_BASE_URL is set) or "mock" for sample data
VITE_DATA_MODE=live

# Local simulator control endpoint used by the Simulation page buttons
VITE_SIM_CONTROL_URL=http://127.0.0.1:8765

# Optional, LOCAL DEVELOPMENT ONLY: pre-fill the simulator control token.
# Never set this for a public (Vercel) build; paste the token in the page instead.
# VITE_SIM_CONTROL_TOKEN=
