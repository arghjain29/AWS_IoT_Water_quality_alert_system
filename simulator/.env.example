# Copy this file to simulator/.env and fill it in. Never commit the real .env.

# AWS IoT Core endpoint. Get it with:
#   aws iot describe-endpoint --endpoint-type iot:Data-ATS --query endpointAddress --output text
IOT_ENDPOINT=xxxxxxxxxxxxxx-ats.iot.ap-south-1.amazonaws.com

# Folder with the device certificates (created by scripts/provision_certs.py)
CERTS_DIR=../certs

# Seconds between readings for each station
PUBLISH_INTERVAL=5

# Random seed; the same seed always produces the same readings
SIM_SEED=42

# Local control endpoint used by the dashboard's Simulation page buttons
CONTROL_PORT=8765
# Any long random string. Put the same value in frontend/.env.local as VITE_SIM_CONTROL_TOKEN
CONTROL_TOKEN=change-me-to-a-long-random-string
